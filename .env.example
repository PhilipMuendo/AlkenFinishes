# Docker Compose deployment configuration.
# Copy to .env and fill in. .env is gitignored — never commit real values.

POSTGRES_USER=alken
POSTGRES_PASSWORD=choose-a-strong-password
POSTGRES_DB=alkenfinishes

# Min 32 chars; production refuses placeholder-looking values.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Encrypts Suprema/BioStar 2 device passwords at rest. Same rules as
# JWT_SECRET (min 32 chars, no placeholder text) — generate the same way.
# Changing it makes existing stored device passwords unreadable.
ENCRYPTION_KEY=

HTTP_PORT=80
# Set this to the public URL users load the app from (e.g.
# https://app.yourcompany.co.ke). `*` is only for local development.
CORS_ORIGIN=*

# ---------------------------------------------------------------------------
# HTTPS (optional, recommended for any real domain)
#
# Uncomment all three to put Caddy in front of the stack. It gets and renews
# a Let's Encrypt certificate by itself. DNS for DOMAIN must point at this
# server and ports 80 + 443 must be open. See DEPLOY.md.
#
# COMPOSE_FILE separator is ":" on Linux/macOS and ";" on Windows.
# ---------------------------------------------------------------------------
# DOMAIN=app.yourcompany.co.ke
# COMPOSE_FILE=docker-compose.yml:docker-compose.https.yml
# CORS_ORIGIN=https://app.yourcompany.co.ke

# Sets both the container clock (TZ) and the zone the code uses where it is
# explicit — document numbering, monthly rollups, printed dates. Leave these
# equal. The container would otherwise run UTC while the business runs three
# hours ahead, filing late-evening work against the wrong day.
APP_TIMEZONE=Africa/Nairobi

# First boot only: creates the superadmin. Production refuses weak defaults.
# Change the password from inside the app once you have signed in.
SEED_ADMIN_EMAIL=owner@yourcompany.com
SEED_ADMIN_PASSWORD=choose-a-strong-password

# ---------------------------------------------------------------------------
# AI features — entirely optional.
#
# With no key set, receipt reading, daily-report drafting and the assistant are
# absent from the UI and every form works by hand exactly as before. Setting a
# key means receipt images and site facts leave the building to be read, so it
# is opt-in by configuration and never by default.
#
# GEMINI_API_KEY is an AI Studio key from https://aistudio.google.com. Newer
# keys start with "AQ.", older ones with "AIza"; both work. Paste it whole.
#
# Whichever key is present is used, Gemini first because it is cheaper. Set
# RECEIPT_PROVIDER to pin one when both are present.
#
# Have more than one Gemini key (a second Google account, say) and want the
# app to move to the next one automatically once today's free allowance on
# the first is gone? List them in GEMINI_API_KEYS instead, comma-separated —
# it takes priority over the singular GEMINI_API_KEY above. Same idea for
# ANTHROPIC_API_KEYS. And if every key of the preferred provider is exhausted
# for the day, the other provider is tried too, provided it has a key —
# nothing extra to configure for that part.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_API_KEYS=
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEYS=
# gemini | anthropic
RECEIPT_PROVIDER=
# Overrides the default model for that provider (services/ai.ts pins a current
# one). Google retires a model without removing it from its model list, so a
# withdrawn model fails with 404 the first time somebody presses the button,
# not at start-up. When that happens the fix is this line and a restart.
RECEIPT_MODEL=

# ---------------------------------------------------------------------------
# Off-site backups (optional) — read by backup.sh. See "Off-site copy" in
# DEPLOY.md for the one-time rclone setup.
#
# RCLONE_REMOTE   where to send backups, e.g. gdrive:AlkenBackups. Empty = off.
# BACKUP_PASSPHRASE   REQUIRED when RCLONE_REMOTE is set. Files are AES-256
#                 encrypted with this before upload. If you lose it, the
#                 off-site backups cannot be opened — keep a copy in a
#                 password manager, and give the client theirs separately.
# REMOTE_RETENTION_DAYS   remote backups older than this are deleted.
# ---------------------------------------------------------------------------
RCLONE_REMOTE=
BACKUP_PASSPHRASE=
REMOTE_RETENTION_DAYS=30
