generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  SUPERVISOR
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum BudgetCategory {
  MATERIALS
  LABOUR
  TRANSPORT
  OTHER
}

// The granular category the field actually uses. Deliberately separate from
// BudgetCategory: budget allocation and reporting stay coarse (four buckets an
// owner can set a threshold against), while an expense claim wants to say what
// it actually was. EXPENSE_CATEGORY_BUDGET_MAP in expenses.ts maps one to the
// other so nothing downstream of BudgetCategory has to change.
enum ExpenseCategory {
  MATERIALS
  LABOUR
  TRANSPORT
  EQUIPMENT_HIRE
  SUBCONTRACTOR
  SITE_OVERHEADS
  OTHER
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MaterialRequestStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
}

enum PaymentType {
  DEPOSIT
  INSTALLMENT
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MPESA
  CHEQUE
  OTHER
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  DONE
}

enum WorkerStatus {
  ACTIVE
  INACTIVE
}

enum AttendanceMethod {
  FINGERPRINT
  MANUAL_OVERRIDE
}

enum AttendanceSource {
  DEVICE_SYNC
  API
  IMPORT
  MANUAL
}

enum OverrideRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// OPEN -> IN_PROGRESS -> RESOLVED -> VERIFIED is the happy path. REJECTED is
// the rework loop: the office looked at the evidence photo and the fix is not
// good enough, so the item goes back to the trade. It is deliberately a
// distinct state from OPEN — a snag that has already failed one inspection is
// not the same risk as one nobody has attempted.
enum SnagStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  VERIFIED
  REJECTED
}

enum SnagSeverity {
  LOW
  MEDIUM
  HIGH
}

enum SafetyIncidentSeverity {
  NEAR_MISS
  MINOR
  SERIOUS
}

// Only the types someone actually books. Deadlines, payroll, service dates,
// birthdays, retention and warranty expiry are NOT here on purpose: they are
// derived from records that already exist (see services/calendarFeeds.ts), and
// storing a copy would let the two disagree the moment the source moves.
enum CalendarEventType {
  MILESTONE
  INSPECTION
  DELIVERY
  MEETING
  SITE_VISIT
  CLIENT_APPOINTMENT
  OTHER
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum ToolStatus {
  ACTIVE
  MAINTENANCE
  RETIRED
}

enum DocumentType {
  CONTRACT
  APPROVAL
  CUSTOMER
  RECEIPT
  COMPLETION
  PHOTO
  INVOICE
  OTHER
}

enum InvoiceType {
  MOBILISATION
  PROGRESS_CLAIM
  VARIATION
  FINAL_ACCOUNT
  RETENTION
}

// DRAFT is the only editable and the only deletable state — it holds no
// invoice number, so deleting a draft cannot leave a gap in the series.
// ISSUED -> PARTIALLY_PAID -> PAID is DERIVED from payments, never set by
// hand. VOID is terminal and RETAINS its number: numbers are never reused.
enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

// Where a prospect sits in the pipeline. WON is set automatically when a
// quotation on the lead is accepted, so the two can never disagree.
enum LeadStage {
  NEW
  CONTACTED
  SITE_VISIT
  QUOTED
  WON
  LOST
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ContractStatus {
  DRAFT
  ISSUED
  SIGNED
  ACTIVE
  COMPLETED
  TERMINATED
}

// A variation only moves the contract value once APPROVED — a pending one is
// visible but must not silently inflate what the client is told they owe.
enum VariationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects                Project[]                   @relation("ProjectSupervisor")
  expenses                Expense[]                   @relation("ExpenseSubmittedBy")
  expensesApproved        Expense[]                   @relation("ExpenseApprovedBy")
  materialRequests        MaterialRequest[]           @relation("MaterialRequestedBy")
  materialRequestsDecided MaterialRequest[]           @relation("MaterialRequestDecidedBy")
  snagsReported           SnagItem[]                  @relation("SnagReportedBy")
  snagsAssigned           SnagItem[]                  @relation("SnagAssignedTo")
  snagsActioned           SnagItem[]                  @relation("SnagLastActionBy")
  snagAttempts            SnagAttempt[]               @relation("SnagAttemptSubmittedBy")
  snagAttemptsReviewed    SnagAttempt[]               @relation("SnagAttemptReviewedBy")
  safetyIncidents         SafetyIncident[]
  overrideRequests        AttendanceOverrideRequest[] @relation("OverrideRequestedBy")
  overrideRequestsDecided AttendanceOverrideRequest[] @relation("OverrideDecidedBy")
  calendarEvents          CalendarEvent[]
  payments                Payment[]
  toolTransfers           ToolTransfer[]
  stockMovements          StockMovement[]
  documents               Document[]
  dailyReports            DailyReport[]
  weeklyReports           WeeklyReport[]
  auditLogs               AuditLog[]
  refreshTokens           RefreshToken[]
  attendanceEdits         AttendanceRecord[]          @relation("AttendanceRecordedBy")
  invoicesCreated         Invoice[]                   @relation("InvoiceCreatedBy")
  paymentsVoided          Payment[]                   @relation("PaymentVoidedBy")
  leadsOwned              Lead[]                      @relation("LeadOwner")
  quotations              Quotation[]                 @relation("QuotationPreparedBy")
  variationsApproved      Variation[]                 @relation("VariationApprovedBy")
  supplierPayments        SupplierPayment[]           @relation("SupplierPaymentPaidBy")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Project {
  id                 String        @id @default(cuid())
  // Human-readable code, e.g. ALK-2026-0017. Allocated from NumberSequence on
  // creation; nullable so projects predating the scheme stay valid.
  code               String?       @unique
  name               String
  // Denormalised snapshot of the client's name at the time. Kept alongside
  // clientId so historical records do not change when a client is renamed.
  clientName         String
  location           String
  contractValue      Decimal       @db.Decimal(14, 2)
  startDate          DateTime
  expectedCompletion DateTime
  status             ProjectStatus @default(PLANNING)
  progressPct        Int           @default(0)
  balanceDueDate     DateTime? // contractual due date for the pending balance; independent of individual Payment rows
  // Fraud-proofing for manual attendance overrides (see AttendanceOverrideRequest).
  // Fingerprint terminals need no geofence — a device does not move — so this
  // is null until an owner sets it, and override requests are still accepted
  // without one; withinGeofence just stays null (unchecked) on the request.
  geofenceLat        Decimal?      @db.Decimal(9, 6)
  geofenceLng        Decimal?      @db.Decimal(9, 6)
  geofenceRadiusM    Int?
  clientId           String?
  client             Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  supervisorId       String?
  supervisor         User?         @relation("ProjectSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  contract          Contract?
  budgetLines       BudgetLine[]
  expenses          Expense[]
  payments          Payment[]
  invoices          Invoice[]
  tasks             Task[]
  assignments       WorkerAssignment[]
  attendance        AttendanceRecord[]
  stockItems        StockItem[]
  documents         Document[]
  dailyReports      DailyReport[]
  weeklyReports     WeeklyReport[]
  toolsHere         Tool[]
  toolTransfersFrom ToolTransfer[]              @relation("ToolTransferFrom")
  toolTransfersTo   ToolTransfer[]              @relation("ToolTransferTo")
  materialRequests  MaterialRequest[]
  snags             SnagItem[]
  safetyIncidents   SafetyIncident[]
  overrideRequests  AttendanceOverrideRequest[]
  calendarEvents    CalendarEvent[]

  @@index([supervisorId])
  @@index([clientId])
}

model BudgetLine {
  id        String         @id @default(cuid())
  projectId String
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category  BudgetCategory
  allocated Decimal        @db.Decimal(14, 2)
  updatedAt DateTime       @updatedAt

  @@unique([projectId, category])
}

model Expense {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // The granular category the submitter picks. `category` is derived from it
  // via EXPENSE_CATEGORY_BUDGET_MAP (expenses.ts) and kept in step so budget
  // rollups (finance.ts) never have to know ExpenseCategory exists.
  expenseCategory ExpenseCategory
  category        BudgetCategory

  amount      Decimal  @db.Decimal(14, 2)
  description String
  receiptUrl  String?
  expenseDate DateTime

  // A supplier is what puts this cost on the payables ledger. NULL means the
  // money is already gone — petty cash, a fuel receipt, wages handed out on
  // site — and the expense behaves exactly as it always has. Only a expense
  // with a supplier is ever reported as owed, which is what keeps every row
  // recorded before suppliers existed from suddenly reading as unpaid.
  supplierId        String?
  supplier          Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  // The supplier's own invoice/delivery-note number, as printed on their paper.
  supplierInvoiceNo String?
  // When the supplier expects to be paid. Drives the payables ageing.
  dueDate           DateTime?

  // INPUT VAT charged by the supplier, already contained within `amount`.
  // `amount` stays the gross figure printed on the supplier's invoice, which
  // is what we actually owe them and therefore what the payables ledger
  // settles against. The ex-VAT cost is amount − vatAmount.
  //
  // Both default to zero, so every row written before this column existed
  // reads as a supplier who charged no VAT — which is exactly how an expense
  // with no VAT recorded should behave.
  vatRatePct Decimal @default(0) @db.Decimal(5, 2)
  vatAmount  Decimal @default(0) @db.Decimal(14, 2)
  // Whether the supplier issued a valid tax invoice (ETR). Input VAT is only
  // reclaimable when they did, so this is what separates "VAT we can recover"
  // from "VAT that is simply part of the cost".
  taxInvoice Boolean @default(false)

  payments SupplierPayment[]

  // Only APPROVED expenses count as actual spend against the budget — see
  // projectFinancials() in finance.ts. A submitted-but-undecided claim is real
  // money that left someone's hand on site, but it is not yet an approved cost.
  status       ExpenseStatus @default(PENDING)
  approvedById String?
  approvedBy   User?         @relation("ExpenseApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?
  rejectReason String?

  submittedById String
  submittedBy   User     @relation("ExpenseSubmittedBy", fields: [submittedById], references: [id])
  createdAt     DateTime @default(now())

  @@index([projectId, expenseDate])
  @@index([projectId, category])
  @@index([projectId, status])
  // Company-wide "what's pending" digests (analytics.ts) filter by status
  // alone, across every project — the (projectId, status) index above can't
  // serve that without a leading projectId, so it needs its own.
  @@index([status])
  // The payables ledger reads every expense that has a supplier, across all
  // projects, oldest first.
  @@index([supplierId, dueDate])
}

// A merchant we buy from. Kept company-wide rather than per-project because
// the question that matters is "what do I owe Bamburi", and that answer spans
// every site at once.
model Supplier {
  id          String  @id @default(cuid())
  name        String  @unique
  contactName String?
  phone       String?
  email       String?
  kraPin      String?
  notes       String?

  // Suppliers are retired, not deleted: their name is printed on costs that
  // have already been reported, and removing it would rewrite that history.
  active Boolean @default(true)

  expenses  Expense[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([active, name])
}

// One part-payment against a supplier's bill.
//
// A bill is very often settled in instalments — some now, the rest when the
// client's money lands — so what is owed is the expense less every payment made
// against it, and never a flag on the expense itself. Nothing here stores a
// running balance: a stored total is a second source of truth that can disagree
// with the payments it claims to summarise.
model SupplierPayment {
  id        String  @id @default(cuid())
  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  // Cash that actually reached the supplier.
  amount      Decimal       @db.Decimal(14, 2)
  method      PaymentMethod
  paymentDate DateTime
  // EFT ref, M-Pesa code, cheque number — how this payment is traced.
  referenceNo String?
  notes       String?
  // OUR proof that the money left: bank slip, M-Pesa message, till receipt.
  proofUrl    String?

  // Tax DEDUCTED from this payment and owed to KRA instead of the supplier —
  // withholding tax, withholding VAT, or both.
  //
  // This settles the supplier's bill just as cash does: withhold 15,000 of a
  // 500,000 bill and paying 485,000 clears it in full. Without this column the
  // bill would sit 15,000 short for ever and somebody would eventually pay it
  // twice. What the supplier RECEIVED is `amount`; what SETTLED the bill is
  // amount + whtAmount + whtVatAmount.
  whtAmount     Decimal   @default(0) @db.Decimal(14, 2)
  whtVatAmount  Decimal   @default(0) @db.Decimal(14, 2)
  // The KRA withholding certificate number issued to the supplier.
  whtCertNo     String?
  // Set once the withheld tax has actually been remitted to KRA.
  whtRemittedAt DateTime?

  paidById  String
  paidBy    User     @relation("SupplierPaymentPaidBy", fields: [paidById], references: [id])
  createdAt DateTime @default(now())

  @@index([expenseId])
  @@index([paymentDate])
}

// Material requests: a supervisor asks for stock, the office decides, and once
// bought it is logged as a StockMovement IN — the request itself never moves
// stock, keeping "what was asked for" separate from "what actually arrived".
model MaterialRequest {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  itemName String
  quantity Decimal   @db.Decimal(12, 2)
  unit     String
  neededBy DateTime? @db.Date
  notes    String?

  status       MaterialRequestStatus @default(PENDING)
  decidedById  String?
  decidedBy    User?                 @relation("MaterialRequestDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  rejectReason String?
  fulfilledAt  DateTime?

  requestedById String
  requestedBy   User     @relation("MaterialRequestedBy", fields: [requestedById], references: [id])
  createdAt     DateTime @default(now())

  @@index([projectId, status])
  @@index([status]) // company-wide pending digest — see Expense's index comment
}

// Exactly one DEPOSIT payment per project is expected; this is enforced in
// the API layer (existence check inside the create transaction -> 409), not
// as a DB constraint, since Prisma's schema has no clean way to express a
// partial unique index ("unique projectId where type = DEPOSIT").
model Payment {
  id            String        @id @default(cuid())
  projectId     String
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type          PaymentType
  amount        Decimal       @db.Decimal(14, 2)
  method        PaymentMethod
  paymentDate   DateTime
  notes         String?
  // The CLIENT's uploaded proof that they sent the money (bank slip, M-Pesa
  // screenshot). Distinct from receiptPdfUrl below, which is OUR document.
  receiptUrl    String?
  submittedById String
  submittedBy   User          @relation(fields: [submittedById], references: [id])
  createdAt     DateTime      @default(now())

  // NULL = money received on account, with no invoice raised against it. True
  // of every pre-existing row and a permanently valid business state: a
  // deposit on signing routinely arrives before any claim is issued.
  invoiceId   String?
  invoice     Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  bankName    String? // bank / M-Pesa till the funds landed in
  referenceNo String? // EFT ref, M-Pesa code, cheque number

  // Tax the CLIENT deducted before paying us and remitted to KRA on our
  // behalf. Government bodies, parastatals and appointed withholding VAT
  // agents do this routinely.
  //
  // This settles the invoice exactly as cash does: a client withholding
  // 15,000 of a 500,000 claim clears it by sending 485,000. Counting only the
  // cash would leave the invoice permanently short, mark it PARTIALLY_PAID
  // for ever and put it on the overdue list to be chased — for money that was
  // never owed to us. What LANDED is `amount`; what SETTLED the invoice is
  // amount + whtAmount + whtVatAmount.
  //
  // These are also a tax asset: the certificate is claimed against our own
  // liability, so `whtCertNo` is chased until it arrives.
  whtAmount         Decimal   @default(0) @db.Decimal(14, 2)
  whtVatAmount      Decimal   @default(0) @db.Decimal(14, 2)
  whtCertNo         String?
  whtCertReceivedAt DateTime?

  // OUR official numbered receipt acknowledging the money.
  receiptNo     String? @unique // RCT-2026-000123
  receiptPdfUrl String?

  // Numbered receipts are VOIDED, never deleted — a hard delete would leave a
  // hole in the receipt series. Every money aggregate must filter voidedAt: null.
  voidedAt   DateTime?
  voidedById String?
  voidedBy   User?     @relation("PaymentVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  voidReason String?

  @@index([projectId, paymentDate])
  @@index([projectId, type])
  @@index([invoiceId])
  @@index([projectId, voidedAt])
}

model Invoice {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  invoiceNo String?       @unique // NULL while DRAFT; allocated at issue time
  type      InvoiceType
  status    InvoiceStatus @default(DRAFT)
  title     String?
  issueDate DateTime      @db.Date
  dueDate   DateTime      @db.Date

  // Client details are SNAPSHOTTED here rather than read through
  // Project.clientName, so re-rendering a two-year-old PDF stays byte-stable
  // even if the project row was edited since.
  clientName    String
  clientAddress String?
  clientKraPin  String?

  // Rates snapshotted at issue: changing VAT in Settings must never re-total
  // an already-issued legal document.
  vatRatePct       Decimal @default(16) @db.Decimal(5, 2)
  retentionRatePct Decimal @default(0) @db.Decimal(5, 2)
  vatInclusive     Boolean @default(false) // are line unitPrices VAT-inclusive?

  // Derived but PERSISTED — recomputed on every DRAFT write, frozen at issue.
  // The PDF renders these columns and never recalculates, so the stored
  // numbers and the printed numbers cannot drift apart.
  subtotal        Decimal @default(0) @db.Decimal(14, 2) // ex-VAT
  vatAmount       Decimal @default(0) @db.Decimal(14, 2)
  grossTotal      Decimal @default(0) @db.Decimal(14, 2) // subtotal + VAT
  retentionAmount Decimal @default(0) @db.Decimal(14, 2)
  netPayable      Decimal @default(0) @db.Decimal(14, 2) // gross - retention

  notes          String?
  pdfUrl         String? // unsigned '/uploads/<name>.pdf'
  pdfGeneratedAt DateTime?
  issuedAt       DateTime?
  voidedAt       DateTime?
  voidReason     String?

  createdById String
  createdBy   User     @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines    InvoiceLine[]
  payments Payment[]

  @@index([projectId, issueDate])
  @@index([projectId, status])
  @@index([status, dueDate]) // drives the A/R + overdue register
}

model InvoiceLine {
  id        String  @id @default(cuid())
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String

  sortOrder   Int     @default(0)
  description String
  quantity    Decimal @db.Decimal(12, 3) // 3dp: 12.5 m2, 0.75 days
  unit        String  @default("item")
  unitPrice   Decimal @db.Decimal(14, 2)
  // Persisted so the printed line-total column always sums to the printed
  // subtotal, and so SUM() in SQL is possible.
  lineTotal   Decimal @db.Decimal(14, 2)
  taxable     Boolean @default(true) // zero-rated / exempt lines

  // ---- Progress claims -----------------------------------------------------
  // Which item of the priced schedule this line claims against. Null for a
  // free-typed line (a mobilisation fee, a one-off), which stays supported.
  // SetNull rather than Cascade: deleting a quotation must never silently
  // rewrite the totals of an issued legal document.
  sourceLineId String?
  sourceLine   QuotationLine? @relation(fields: [sourceLineId], references: [id], onDelete: SetNull)

  // How complete that schedule item is TO DATE, not in this claim alone. The
  // value of this claim is derived: cumulative value minus whatever earlier
  // claims already took. "Previously claimed" is deliberately never stored —
  // it is a sum over prior invoices, and a stored copy could disagree with them.
  cumulativePct Decimal? @db.Decimal(5, 2)

  @@index([invoiceId, sortOrder])
  @@index([sourceLineId])
}

// One counter row per (series, year), incremented inside the transaction that
// creates the numbered row. Deliberately NOT a native Postgres sequence:
// nextval() is non-transactional by design, so a rollback would burn the
// number permanently — the opposite of what a document series needs.
model NumberSequence {
  scope     String   @id // "INVOICE:2026" | "RECEIPT:2026"
  next      Int      @default(1)
  updatedAt DateTime @updatedAt
}

model Task {
  id            String     @id @default(cuid())
  projectId     String
  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase         String // e.g. "Painting", "Tiles"
  name          String // e.g. "Primer", "Grouting"
  status        TaskStatus @default(NOT_STARTED)
  completionPct Int        @default(0)
  // How much of the job this task represents, relative to the others. The
  // recommended value is the task's amount from the priced schedule, since that
  // is what a progress claim is measured on, but any consistent unit works
  // (planned days, area, crew-days) — only the ratios matter.
  //
  // Defaults to 1 so a project where nobody has set weights produces exactly
  // the plain mean it produced before this field existed.
  weight        Decimal    @default(1) @db.Decimal(14, 2)
  notes         String?
  sortOrder     Int        @default(0)
  updatedAt     DateTime   @updatedAt
  createdAt     DateTime   @default(now())

  photos TaskPhoto[]

  @@index([projectId, phase])
}

model TaskPhoto {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileUrl    String
  caption    String?
  uploadedAt DateTime @default(now())

  @@index([taskId])
}

model Worker {
  id          String       @id @default(cuid())
  name        String
  phone       String?
  trade       String // e.g. Painter, Tiler, Mason
  hourlyRate  Decimal      @db.Decimal(10, 2)
  status      WorkerStatus @default(ACTIVE)
  biometricId String?      @unique // template/enrolment ID on fingerprint device
  // Date only — the year is kept because it is on the ID anyway, but the
  // calendar matches on month and day so a birthday recurs every year.
  dateOfBirth DateTime?    @db.Date
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  assignments      WorkerAssignment[]
  attendance       AttendanceRecord[]
  syncIssues       AttendanceSyncIssue[]
  overrideRequests AttendanceOverrideRequest[]
}

model WorkerAssignment {
  id        String    @id @default(cuid())
  workerId  String
  worker    Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  startDate DateTime  @default(now())
  endDate   DateTime? // null = currently assigned

  @@index([projectId, endDate])
  @@index([workerId, endDate])
}

model AttendanceRecord {
  id           String           @id @default(cuid())
  workerId     String
  worker       Worker           @relation(fields: [workerId], references: [id], onDelete: Cascade)
  projectId    String
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date         DateTime         @db.Date
  checkIn      DateTime
  checkOut     DateTime?
  deviceId     String?
  method       AttendanceMethod @default(FINGERPRINT)
  source       AttendanceSource @default(DEVICE_SYNC)
  externalId   String? // device-side record id; idempotency is scoped per device
  hoursWorked  Decimal?         @db.Decimal(6, 2)
  labourCost   Decimal?         @db.Decimal(12, 2) // hoursWorked * worker rate at time of record
  recordedById String? // set when MANUAL_OVERRIDE
  recordedBy   User?            @relation("AttendanceRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())

  sourceOverrideRequest AttendanceOverrideRequest?

  @@unique([workerId, projectId, date])
  @@unique([deviceId, externalId])
  @@index([projectId, date])
}

// The only path to a manually-entered attendance record. A supervisor cannot
// write AttendanceRecord directly — they can only ask for one, with the GPS
// coordinates their device reports at the moment of asking, and a superadmin
// decides. That is what "supervisors locked out of editing hours" means in
// practice: the exception path is now a request, not an edit.
model AttendanceOverrideRequest {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workerId  String
  worker    Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)

  date     DateTime  @db.Date
  checkIn  DateTime
  checkOut DateTime?
  reason   String

  // Captured client-side at submission. A phone GPS can be spoofed, so this is
  // fraud-DETERRENT rather than fraud-PROOF — it gives the approving
  // superadmin a fact to weigh, not an automatic gate. withinGeofence stays
  // null when the project has no geofence configured to check against.
  latitude       Decimal? @db.Decimal(9, 6)
  longitude      Decimal? @db.Decimal(9, 6)
  withinGeofence Boolean?

  status        OverrideRequestStatus @default(PENDING)
  requestedById String
  requestedBy   User                  @relation("OverrideRequestedBy", fields: [requestedById], references: [id])
  decidedById   String?
  decidedBy     User?                 @relation("OverrideDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?
  rejectReason  String?

  // The record created on approval, kept for traceability from the request
  // that authorised it. SetNull rather than cascading a delete backwards.
  resultingRecordId String?           @unique
  resultingRecord   AttendanceRecord? @relation(fields: [resultingRecordId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([projectId, status])
  @@index([status]) // company-wide pending digest — see Expense's index comment
}

model StockItem {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  unit      String // bags, litres, pcs, m2
  quantity  Decimal  @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements StockMovement[]

  @@unique([projectId, name])
}

model StockMovement {
  id          String            @id @default(cuid())
  stockItemId String
  stockItem   StockItem         @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  type        StockMovementType
  quantity    Decimal           @db.Decimal(12, 2)
  reason      String
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  date        DateTime          @default(now())

  @@index([stockItemId, date])
}

// Company-owned durable equipment (paint brushes, drills, ladders, etc.),
// distinct from StockItem: tools aren't consumed, they circulate between
// sites. One row per catalog item with a single current location/quantity —
// deliberately no simultaneous multi-site split; a batch that needs to live
// in two places at once should be registered as two separate catalog rows
// (e.g. "Paint brushes (Batch A)" / "(Batch B)").
model Tool {
  id               String     @id @default(cuid())
  name             String
  category         String? // e.g. "Power tools", "Hand tools" — free text, not an enum
  unit             String     @default("pcs")
  quantity         Decimal    @default(0) @db.Decimal(12, 2)
  currentProjectId String? // null = central store / unassigned
  currentProject   Project?   @relation(fields: [currentProjectId], references: [id], onDelete: SetNull)
  // Separate from location: a tool can be AT a site and still be down for
  // repair. MAINTENANCE/RETIRED are excluded from ToolTransfer's "available
  // to move" list in the API, not from this table.
  status           ToolStatus @default(ACTIVE)
  conditionNotes   String?
  // Next scheduled service. Feeds the calendar and the equipment card; a date
  // in the past is what makes a tool "service overdue" rather than a separate
  // flag that someone would have to remember to clear.
  nextServiceDate  DateTime?  @db.Date
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  transfers ToolTransfer[]

  @@index([currentProjectId])
}

// Immutable transfer ledger — every location change is a logged, photo-
// evidenced event. Transfers move a tool's entire current quantity in one
// step (all-or-nothing); quantity is frozen here at transfer time.
model ToolTransfer {
  id              String   @id @default(cuid())
  toolId          String
  tool            Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  fromProjectId   String? // null = was in central store before this transfer
  fromProject     Project? @relation("ToolTransferFrom", fields: [fromProjectId], references: [id], onDelete: SetNull)
  toProjectId     String
  toProject       Project  @relation("ToolTransferTo", fields: [toProjectId], references: [id], onDelete: Cascade)
  quantity        Decimal  @db.Decimal(12, 2)
  transferDate    DateTime @default(now())
  proofPhotoUrl   String // required — a transfer cannot be logged without proof of delivery
  notes           String?
  transferredById String
  transferredBy   User     @relation(fields: [transferredById], references: [id])
  createdAt       DateTime @default(now())

  @@index([toolId, transferDate])
  @@index([toProjectId])
  @@index([fromProjectId])
}

model Document {
  id              String       @id @default(cuid())
  projectId       String
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type            DocumentType
  name            String
  fileUrl         String
  mimeType        String
  sizeBytes       Int
  uploadedById    String
  uploadedBy      User         @relation(fields: [uploadedById], references: [id])
  createdAt       DateTime     @default(now())
  // Rendered by the system (an invoice or receipt PDF) rather than uploaded.
  // The same file is referenced by an Invoice/Payment row, so deleting it from
  // the Documents tab would dead-link a legal document — blocked in the handler.
  systemGenerated Boolean      @default(false)

  @@index([projectId, type])
  @@index([projectId, createdAt])
}

model DailyReport {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date           DateTime @db.Date
  workCompleted  String
  workersPresent Int
  materialsUsed  String?
  challenges     String?
  photoUrls      String[] @default([])

  // Richer site-diary fields, all optional so the form stays quick to fill on
  // an ordinary day — a supervisor should not have to type "none" seven times.
  weather            String?
  visitors           String?
  materialsDelivered String?
  instructionsGiven  String?
  delays             String?
  safetyNotes        String?
  equipmentOnSite    String?

  submittedById String
  submittedBy   User     @relation(fields: [submittedById], references: [id])
  createdAt     DateTime @default(now())

  @@unique([projectId, date])
}

// A supervisor's written weekly summary for a site — one per week per project.
// weekEnding is the last day (Sunday) of the ISO week the report covers.
model WeeklyReport {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  weekEnding    DateTime @db.Date
  summary       String
  milestones    String?
  issues        String?
  nextWeekPlan  String?
  photoUrls     String[] @default([])
  submittedById String
  submittedBy   User     @relation(fields: [submittedById], references: [id])
  createdAt     DateTime @default(now())

  @@unique([projectId, weekEnding])
  @@index([projectId, weekEnding])
}

model AttendanceDevice {
  id           String       @id @default(cuid())
  name         String
  vendor       DeviceVendor @default(ZKTECO)
  apiKeyHash   String       @unique // generated for every device; unused by SUPREMA (poll, not push)
  serialNumber String?      @unique // ZKTeco/ADMS push devices identify by serial number
  active       Boolean      @default(true)
  projectId    String? // when set, the device may only submit records for this site
  lastSyncAt   DateTime?
  createdAt    DateTime     @default(now())

  // Suprema BioLite Net (and other BioStar 2 terminals) don't push to a URL —
  // they report into a BioStar 2 server on the LAN, which we poll over its
  // REST API. One row here is one BioStar 2 endpoint; biostarDeviceId narrows
  // it to a single physical terminal when more than one reports to the same
  // BioStar 2 instance.
  biostarBaseUrl     String? // e.g. https://192.168.1.50 (the BioStar 2 server, not the terminal)
  biostarLoginId     String?
  biostarPasswordEnc String? // AES-256-GCM, see services/crypto.ts — never returned by the API
  biostarDeviceId    String?
  // BioStar 2's self-issued TLS cert is normally self-signed on a LAN
  // appliance. Off by default; turning it on is a real security tradeoff the
  // admin makes knowingly, not a default.
  biostarInsecureTls Boolean @default(false)
  // Cursor: highest BioStar 2 event ID already ingested. An ID cursor survives
  // clock drift between our server and theirs in a way a timestamp cursor
  // would not.
  biostarLastEventId String?
}

enum DeviceVendor {
  ZKTECO
  SUPREMA
}

// Punches a sync could not turn into attendance (unknown fingerprint, worker
// with no active assignment, etc.). Surfaced to the admin so nothing is lost
// silently. Deduped per (device, biometricId, reason) while unresolved.
model AttendanceSyncIssue {
  id          String    @id @default(cuid())
  deviceId    String? // our AttendanceDevice id, when the device is known
  biometricId String // raw PIN/template id the device reported
  workerId    String?
  worker      Worker?   @relation(fields: [workerId], references: [id], onDelete: SetNull)
  reason      String // unknown_worker | no_assignment | wrong_site | invalid_time
  detail      String?
  occurrences Int       @default(1)
  lastSeenAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@unique([deviceId, biometricId, reason])
  @@index([resolvedAt, lastSeenAt])
}

// The customer. Introduced with the pre-project pipeline so a lead, quotation,
// contract and project all point at one record instead of repeating a name.
model Client {
  id            String   @id @default(cuid())
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  kraPin        String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  leads      Lead[]
  quotations Quotation[]
  contracts  Contract[]
  projects   Project[]

  @@index([name])
}

model Lead {
  id                String    @id @default(cuid())
  clientId          String
  client            Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  estimatedValue    Decimal?  @db.Decimal(14, 2)
  stage             LeadStage @default(NEW)
  source            String?
  expectedCloseDate DateTime? @db.Date
  lostReason        String?
  ownerId           String?
  owner             User?     @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  quotations Quotation[]

  @@index([stage, expectedCloseDate])
  @@index([clientId])
}

model Quotation {
  id          String          @id @default(cuid())
  quotationNo String?         @unique // NULL while DRAFT, same rule as an invoice
  clientId    String
  client      Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  leadId      String?
  lead        Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  title       String
  status      QuotationStatus @default(DRAFT)
  issueDate   DateTime        @db.Date
  validUntil  DateTime        @db.Date

  // Snapshotted and persisted for the same reason as Invoice: a quotation that
  // has gone to a client is a document, not a live calculation.
  clientNameSnapshot String
  vatRatePct         Decimal @default(16) @db.Decimal(5, 2)
  subtotal           Decimal @default(0) @db.Decimal(14, 2)
  vatAmount          Decimal @default(0) @db.Decimal(14, 2)
  total              Decimal @default(0) @db.Decimal(14, 2)

  termsText    String?
  notes        String?
  pdfUrl       String?
  sentAt       DateTime?
  decidedAt    DateTime?
  rejectReason String?

  preparedById String
  preparedBy   User     @relation("QuotationPreparedBy", fields: [preparedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lines    QuotationLine[]
  contract Contract?

  @@index([clientId, issueDate])
  @@index([status, validUntil])
}

model QuotationLine {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  sortOrder   Int       @default(0)
  description String
  quantity    Decimal   @db.Decimal(12, 3)
  unit        String    @default("item")
  unitPrice   Decimal   @db.Decimal(14, 2)
  lineTotal   Decimal   @db.Decimal(14, 2)
  taxable     Boolean   @default(true)

  // Progress claims measured against this item of the priced schedule.
  claimLines InvoiceLine[]

  @@index([quotationId, sortOrder])
}

model Contract {
  id          String     @id @default(cuid())
  contractNo  String?    @unique
  clientId    String
  client      Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // One contract per quotation, and one per project once converted.
  quotationId String?    @unique
  quotation   Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  projectId   String?    @unique
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)

  title                  String
  status                 ContractStatus @default(DRAFT)
  // The Contract Sum, EXCLUSIVE of VAT — the standard way a construction
  // contract states it, and the base retention is calculated on. VAT is added
  // on each payment application. Project.contractValue holds the VAT-inclusive
  // figure, because that is the cash the client actually pays.
  originalValue          Decimal        @db.Decimal(14, 2)
  vatRatePct             Decimal        @default(16) @db.Decimal(5, 2)
  retentionPct           Decimal        @default(5) @db.Decimal(5, 2)
  defectsLiabilityMonths Int            @default(6)

  startDate               DateTime  @db.Date
  expectedCompletion      DateTime  @db.Date
  signedDate              DateTime? @db.Date
  // Starts the defects liability clock; retention is released after it ends.
  practicalCompletionDate DateTime? @db.Date

  generatedPdfUrl String? // rendered by us from the quotation
  signedPdfUrl    String? // uploaded scan of the executed copy
  boqUrl          String?
  specsUrl        String?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variations Variation[]

  @@index([clientId])
  @@index([status])
}

model Variation {
  id            String          @id @default(cuid())
  contractId    String
  contract      Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  reference     String // VO-001, sequential within the contract
  description   String
  // May be negative: an omission reduces the contract value.
  amount        Decimal         @db.Decimal(14, 2)
  status        VariationStatus @default(PENDING)
  requestedDate DateTime        @db.Date
  approvedDate  DateTime?
  approvedById  String?
  approvedBy    User?           @relation("VariationApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectReason  String?
  documentUrl   String?
  createdAt     DateTime        @default(now())

  @@unique([contractId, reference])
  @@index([contractId, status])
}

// The defect/snag list. A photo with a pin is how a site actually communicates
// "this corner, this crack" — a text description alone forces the reader to
// go and find it. annotation is {x, y} as fractions (0-1) of photoUrl's
// dimensions, so it survives the image being viewed at any size.
model SnagItem {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  location    String? // "3rd floor, unit 3B, bathroom" — free text, not geocoded
  severity    SnagSeverity @default(MEDIUM)
  status      SnagStatus   @default(OPEN)
  photoUrl    String?
  annotation  Json?
  dueDate     DateTime?    @db.Date

  assignedToId String?
  assignedTo   User?   @relation("SnagAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  // Set when work is marked done; a photo of the fix is how the office
  // verifies it without a return site visit.
  resolvedPhotoUrl String?
  resolvedAt       DateTime?
  verifiedAt       DateTime? // office confirms the fix from resolvedPhotoUrl
  lastActionById   String?
  lastActionBy     User?     @relation("SnagLastActionBy", fields: [lastActionById], references: [id], onDelete: SetNull)

  // The rework loop. reworkCount is how many times a claimed fix has been sent
  // back — the number the office actually argues about, and cheap to read
  // without walking the attempt history.
  reworkCount  Int       @default(0)
  rejectedAt   DateTime?
  rejectReason String?

  attempts SnagAttempt[]

  reportedById String
  reportedBy   User     @relation("SnagReportedBy", fields: [reportedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([projectId, status])
}

// One attempt at fixing a snag, kept even after it is rejected. Without this
// the evidence photo of a failed fix is overwritten by the next attempt, and
// the argument about whether a trade fixed something twice becomes unwinnable.
// Append-only: rows are never edited, only added.
model SnagAttempt {
  id       String   @id @default(cuid())
  snagId   String
  snag     SnagItem @relation(fields: [snagId], references: [id], onDelete: Cascade)
  attempt  Int // 1-based, in order
  photoUrl String?
  notes    String?

  // Null while the office has not looked at it yet; set on accept or reject.
  accepted     Boolean?
  rejectReason String?
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("SnagAttemptReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  submittedById String
  submittedBy   User     @relation("SnagAttemptSubmittedBy", fields: [submittedById], references: [id])
  createdAt     DateTime @default(now())

  @@unique([snagId, attempt])
  @@index([snagId])
}

model SafetyIncident {
  id           String                 @id @default(cuid())
  projectId    String
  project      Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  occurredAt   DateTime
  severity     SafetyIncidentSeverity
  description  String
  actionTaken  String?
  photoUrl     String?
  reportedById String
  reportedBy   User                   @relation(fields: [reportedById], references: [id])
  createdAt    DateTime               @default(now())

  @@index([projectId, occurredAt])
}

// Site milestones, inspections, deliveries — the events behind the Calendar.
// projectId null means a company-wide event (e.g. a public holiday, a head
// office meeting) that shows on every project's calendar.
model CalendarEvent {
  id          String            @id @default(cuid())
  projectId   String?
  project     Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  type        CalendarEventType @default(OTHER)
  date        DateTime          @db.Date
  notes       String?
  createdById String
  createdBy   User              @relation(fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())

  @@index([projectId, date])
  @@index([date])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // e.g. expense.create
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
